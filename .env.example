# Autenticação do Painel de Notícias
# JWT_SECRET: string aleatória longa (mínimo 32 caracteres)
JWT_SECRET=sua_chave_secreta_muito_longa_aqui_minimo_32_caracteres
ADMIN_PASSWORD=sua_senha_de_administrador

# Banco de dados (Turso). Sem essas variáveis, usa ./data/noticias.db local
TURSO_DATABASE_URL=libsql://serviscon-landing-page-serviscon.aws-sa-east-1.turso.io
TURSO_AUTH_TOKEN=

# Imagens (Vercel Blob). Criado automaticamente ao conectar um Blob store ao projeto na Vercel.
# Sem ele, as imagens são salvas em public/noticias (somente desenvolvimento)
BLOB_READ_WRITE_TOKEN=
